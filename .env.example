# URL publique de l'application (sans / final). Sert à construire l'URI de redirection OAuth :
#   ${BASE_URL}/admin/oauth/callback
BASE_URL=http://localhost:3000

# Identifiants OAuth "Application Web" créés dans Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Accès à /admin (authentification HTTP Basic)
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi

# Nombre de reverse proxies devant l'app (pour l'IP réelle utilisée par l'anti-spam)
TRUST_PROXY=1

# Port exposé sur la machine hôte
HOST_PORT=3000
